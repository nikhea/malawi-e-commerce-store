{
  "name": "@nikhea/malawi-store-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Malawi E-Commerce Store API (/api/v1) — auth, catalog, cart, orders, Stripe payments, reviews, plus money helpers (USD cents, legacy MWK) and districts.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "malawi",
    "ecommerce",
    "mwk",
    "stripe",
    "sdk",
    "storefront"
  ],
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
